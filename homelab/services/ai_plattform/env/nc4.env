# Context Chat Backend — NC Instance 4
# ════════════════════════════════════════
# IMPORTANT: Update NEXTCLOUD_URL to your actual NC4 URL before deploying.
# IMPORTANT: The APP_SECRET below must match the --json-info secret in setup-nextcloud.sh

AA_VERSION=3.0.0
APP_ID=context_chat_backend
APP_DISPLAY_NAME=Context Chat Backend
APP_VERSION=5.3.0
APP_HOST=0.0.0.0
APP_PORT=10034
APP_SECRET=79a57e579ded47ed8532a3d0410d9e37599eed3bed5e42b8a97da2154e87f239
APP_PERSISTENT_STORAGE=/nc_app_context_chat_backend_data
NEXTCLOUD_URL=https://vogt-cloud.de

# GPU
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=compute
CUDA_VISIBLE_DEVICES=0

# Download embedding model on first start
CC_DOWNLOAD_MODELS_FROM_HF=true

# Optional: Use shared embedding server to save VRAM (uncomment if using Phase 9)
# CC_EM_BASE_URL=http://GPU_VM_IP:5555/v1
