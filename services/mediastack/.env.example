# ── User / Permissions ──────────────────────────────────
PUID=1000
PGID=1000
TZ=Europe/Berlin

# ── Paths ───────────────────────────────────────────────
# Local SSD for app configs
DATA_DIR=/opt/mediastack
# NFS mount point for media (movies, tv, downloads)
MEDIA_DIR=/media

# ── Network ─────────────────────────────────────────────
LOCAL_SUBNET=192.168.1.0/24

# ── Plex ────────────────────────────────────────────────
# Get claim token from https://plex.tv/claim (valid 4 min)
PLEX_CLAIM=

# ── SABnzbd ────────────────────────────────────────────
SABNZBD_PORT=8080

# ── VPN (Gluetun / NordVPN) ─────────────────────────────
# Docs: https://github.com/qdm12/gluetun-wiki/blob/main/setup/providers/nordvpn.md
VPN_SERVICE_PROVIDER=nordvpn
VPN_TYPE=openvpn
# ⚠ NOT your NordVPN email/password! Get service credentials from:
# https://my.nordaccount.com/dashboard/nordvpn/manual-configuration/service-credentials/
VPN_USERNAME=
VPN_PASSWORD=
VPN_SERVER_COUNTRIES=Netherlands
